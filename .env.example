# Copy to .env.local for dev, and set these as Vercel env vars for production.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# Optional: a sender on a domain you verified in Resend (e.g. CAA Desk <desk@caameetings.com>).
# Until then the Resend test sender is used and recipients are limited to your own verified email.
RESEND_FROM=
